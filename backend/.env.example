# Copy to .env and fill in. Nothing here is required to run the smoke test.

# --- Language model --------------------------------------------------------
# "groq" for development (free, fast), "gemini" for the demo.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- Storage ---------------------------------------------------------------
# SQLite by default. For deployment point this at Postgres:
#   postgresql+psycopg://user:password@host:5432/knowledgepulse
DATABASE_URL=sqlite:///./data/knowledgepulse.db
CHROMA_PATH=./data/chroma
UPLOAD_PATH=./data/uploads

# --- Crawling --------------------------------------------------------------
CRAWL_MAX_PAGES=120
CRAWL_MAX_DEPTH=3
CRAWL_DELAY_SECONDS=0.4

# --- Retrieval -------------------------------------------------------------
RETRIEVAL_TOP_K=5
LOW_CONFIDENCE_THRESHOLD=0.40

# --- Analytics -------------------------------------------------------------
HDBSCAN_MIN_CLUSTER_SIZE=6
UMAP_NEIGHBOURS=12
TOPIC_MATCH_THRESHOLD=0.72

# Priority weights: volume, growth, confidence deficit, severity. Must sum to 1.
W_VOLUME=0.30
W_GROWTH=0.30
W_CONFIDENCE=0.25
W_SEVERITY=0.15

# --- API -------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
