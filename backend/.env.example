# Copy to .env and fill in. Nothing here is required to run the smoke test.

# --- Language model --------------------------------------------------------
# "groq" for development (free, fast), "gemini" for the demo.
LLM_PROVIDER=gemini
GROQ_API_KEY=
# Use a non-reasoning model. openai/gpt-oss-20b spends its token budget on hidden
# reasoning and returns empty JSON for the seeding and question scripts.
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Storage ---------------------------------------------------------------
# SQLite by default. For deployment point this at Postgres:
#   postgresql+psycopg://user:password@host:5432/knowledgepulse
DATABASE_URL=sqlite:///./data/knowledgepulse.db
CHROMA_PATH=./data/chroma
UPLOAD_PATH=./data/uploads

# --- Crawling and chunking --------------------------------------------------
# Global defaults. Each workspace can override size, overlap and page limit
# from its settings dialog; overrides apply on the next index or reindex.
CRAWL_MAX_PAGES=120
CRAWL_MAX_DEPTH=3
CRAWL_DELAY_SECONDS=0.4
CHUNK_TARGET_WORDS=220
CHUNK_OVERLAP_WORDS=40

# --- Retrieval -------------------------------------------------------------
RETRIEVAL_TOP_K=5
LOW_CONFIDENCE_THRESHOLD=0.40

# --- Analytics -------------------------------------------------------------
HDBSCAN_MIN_CLUSTER_SIZE=6
UMAP_NEIGHBOURS=12
TOPIC_MATCH_THRESHOLD=0.72

# Priority weights: volume, growth, confidence deficit, severity. Must sum to 1.
W_VOLUME=0.30
W_GROWTH=0.30
W_CONFIDENCE=0.25
W_SEVERITY=0.15

# --- API -------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Sign-in (see docs/AUTH.md) ----------------------------------------------
# A demo account in org_default, created or updated on every start. Change the
# password for any deployment others can reach; empty password = no demo user.
DEMO_USER_EMAIL=demo@knowledgepulse.local
DEMO_USER_PASSWORD=knowledgepulse
DEMO_USER_NAME=Sinchana
SESSION_TTL_HOURS=336
# Lets a trusted server (e.g. a Next.js backend) name the organisation with
# X-Organization-Id plus X-Internal-Key. Leave empty unless you need it.
INTERNAL_API_KEY=
