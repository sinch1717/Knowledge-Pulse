# Leave unset to run the frontend on mock data (no backend required).
# Set to your FastAPI base URL once the backend exists.
VITE_API_BASE_URL=

# for local, paste the backend URL here, e.g. http://localhost:8000

# Sign in with the backend's demo account (DEMO_USER_EMAIL / DEMO_USER_PASSWORD in
# backend/.env) or one made with scripts/create_user.py. The organisation and the
# name in the account menu come from that account; they are no longer set here.
