# Leave unset to run the frontend on mock data (no backend required).
# Set to your FastAPI base URL once the backend exists.
VITE_API_BASE_URL=

# for local, paste the backend URL here, e.g. http://localhost:8000

# Name shown in the account menu at the top right.
VITE_ACCOUNT_NAME=Sinchana

# Organisation sent as X-Organization-Id on every request. The backend requires
# it. org_default holds everything created before multi-tenancy.
VITE_ORGANIZATION_ID=org_default
